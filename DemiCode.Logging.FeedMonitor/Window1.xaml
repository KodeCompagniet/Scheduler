<Window x:Class="DemiCode.Logging.FeedMonitor.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Status feed" Loaded="Window_Loaded" FlowDirection="LeftToRight">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="60" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <Button ToolTip="Reload the status feed" Name="ReloadButton" Click="ReloadButton_Click">Reload</Button>
        <ItemsControl Name="FeedViewer">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}" Text="{Binding Path=Title}"/>
                        <TextBlock>Updated: </TextBlock><TextBlock Text="{Binding Path=LastUpdatedTime}"/>
                        <TextBlock>Published: </TextBlock><TextBlock Text="{Binding Path=PublishDate}"/>
                        <TextBlock Text="{Binding Path=Summary}"/>
                        <TextBlock Text="{Binding Path=Content}"/>
                        <TextBlock Visibility="Visible">Exception: </TextBlock><TextBlock Text="{Binding Path=ExceptionText}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
