<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="scheduling" type="DemiCode.Scheduling.Configuration.SchedulerSettings, DemiCode.Scheduling, Culture=neutral, PublicKeyToken=069d10bcdee4c3e4"/>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>

	<scheduling defaultScheduler="prod">
		<schedulers>
			<scheduler name="prod">
				<tasks>
					<task type="TestConsole.DivByZeroTask, TestConsole" file="c:\program files\demicode\scheduler 1.1\DemiCode.SchedulerService.exe.config" />
				</tasks>
				<loggers>
					<Log4netLogger />
				</loggers>
				<IntervalSchedule name="fast">
					<start>2006-11-30 15:50:00</start>
					<interval>00:00:01.00</interval>
				</IntervalSchedule>
			</scheduler>
		</schedulers>
	</scheduling>

	<log4net>

		<!-- Loggers -->

		<root>
			<level value="ALL" />
			<appender-ref ref="ConsoleAppender" />
		</root>


		<!-- Appenders -->

		<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline" />
			</layout>
		</appender>
		
		<appender name="DebugLog" type="log4net.Appender.RollingFileAppender, log4net" >
			<filter type="log4net.Filter.LevelMatchFilter">
				<levelToMatch value="DEBUG" />
			</filter>
			<filter type="log4net.Filter.DenyAllFilter" />
			<file value="c:\\schedulerservice\\Debug.txt" />
			<appendToFile value="true" />
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd-HHmm" />
			<layout type="log4net.Layout.PatternLayout">
				<!--<conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline" />-->
				<conversionPattern value="%date - %message%newline" />
			</layout>
		</appender>
		<appender name="InfoLog" type="log4net.Appender.RollingFileAppender, log4net" >
			<filter type="log4net.Filter.LevelMatchFilter">
				<levelToMatch value="INFO" />
			</filter>
			<filter type="log4net.Filter.DenyAllFilter" />
			<file value="c:\\schedulerservice\\Info.txt" />
			<appendToFile value="true" />
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd-HHmm" />
			<layout type="log4net.Layout.PatternLayout">
				<!--<conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline" />-->
				<conversionPattern value="%date - %message%newline" />
			</layout>
		</appender>
		<appender name="WarnLog" type="log4net.Appender.RollingFileAppender, log4net" >
			<filter type="log4net.Filter.LevelRangeFilter">
				<levelMin value="WARN" />
				<levelMax value="FATAL" />
			</filter>
			<file value="c:\\schedulerservice\\Warn.txt" />
			<appendToFile value="true" />
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd-HHmm" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline" />
			</layout>
		</appender>
		<appender name="WarnEventLog" type="log4net.Appender.EventLogAppender, log4net" >
			<filter type="log4net.Filter.LevelRangeFilter">
				<levelMin value="WARN" />
				<levelMax value="FATAL" />
			</filter>
			<applicationName value="DemiCode Scheduler Service" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline" />
			</layout>
		</appender>
	</log4net>
</configuration>