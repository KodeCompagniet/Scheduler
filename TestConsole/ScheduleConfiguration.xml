	<experimental>
		<!-- Composite scheduling 
		
		Uses "ranges", like 'day', 'hour', 'year' etc,
		and "points", like 'every'
		
		Alternative ranges: 'idle','deploying', or other 'userdefinedactivity'...
		-->
		<schedule name="recurring">
			<!--
            // Effective rule is:
            //  every monday to friday, every hour from 9 to 17, every third hour from 17 to 9
            //  every weekend day (saturday and sunday) once at 23:00
			-->
			<day start="monday" end="friday">
				<hour start="9" end="17">
					<every hour="1">
						<!-- Leaf schedule. Event will be fired from here -->
					</every>
				</hour>
				<hour start="17" end="9">
					<every hour="3">
						<!-- Leaf schedule. Event will be fired from here -->
					</every>
				</hour>
			</day>
			<day only="weekends">
				<hour only="23">
					<!-- Leaf schedule. Event will be fired from here -->
				</hour>
			</day>
		</schedule>
		<schedule name="year2006">
			<!--
            // Effective rule is:
            //  from 01.01.2006 to 31.12.2006:
            //      every monday to friday, every hour from 9 to 17, every third hour from 17 to 9
            //      every weekend day (saturday and sunday) once at 23:00
			-->
			<year only="2006">
				<day start="monday" end="friday">
					<hour start="9" end="17">
						<!-- Leaf schedule. Event will be fired from here -->
					</hour>
				</day>
				<day only="weekends">
					<hour only="23">
						<!-- Leaf schedule. Event will be fired from here -->
					</hour>
				</day>
			</year>
		</schedule>

		<schedule name="recurringevery5second">
			<second every="5" />
		</schedule>

		<!-- Composite scheduling using named references -->
		<schedule name="workinghours">
			<day start="monday" end="friday">
				<hour start="9" end="17" />
			</day>
		</schedule>

		<schedule name="weekendoneshot">
			<day only="weekends">
				<hour only="23" />
			</day>
		</schedule>

		<schedule name="recurring">
			<schedule ref="workinghours" />
			<schedule ref="weekendoneshot" />
		</schedule>
		<schedule name="year2006">
			<year only="2006">
				<schedule ref="recurring" />
			</year>
		</schedule>


		<!--
		While computer is idle, event will be fired each five minutes.
		-->
		<schedule name="OnIdle">
			<day only="weekdays">
				<idle>
					<hour start="11" stop="12">
						<minute every="5" />
					</hour>
				</idle>
				<workingset threshold="50MB">
					<minute every="5" />
				</workingset>
			</day>
		</schedule>

		<!-- 
		While the process consumes more than 50MB physical memory, event will be fired each five minutes.
		-->
		<schedule name="OnWorkingsetToHigh">
			<workingset threshold="50MB">
				<every minute="5" />
			</workingset>
		</schedule>

		<!-- Download public calendar from Google -->
		<schedule name="googleHolidays">
			<googlecalendar url="http://...." />
		</schedule>
	</experimental>
