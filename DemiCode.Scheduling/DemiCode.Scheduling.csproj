<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <AssemblyName>DemiCode.Scheduling</AssemblyName>
    <RootNamespace>DemiCode.Scheduling</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{3C7ED8E3-6128-482F-BC3C-0BED63584CD6}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyInfo.Common.cs" Link="AssemblyInfo.Common.cs" />
    <Compile Include="..\AssemblyInfo.Version.cs" Link="AssemblyInfo.Version.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemiCode.Shared\DemiCode.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Configuration" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SolutionDir)Samples" />
  </Target>
</Project>