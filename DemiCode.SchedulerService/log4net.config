<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <log4net>
    <!-- Loggers -->
    <root>
      <level value="WARN" />
      <appender-ref ref="EventLogAppender" />
      <appender-ref ref="RollingFileAppender" />
    </root>

    <!-- Events from the Scheduler Service -->
    <logger name="DemiCode.SchedulerService">
      <level value="INFO" />
    </logger>

    <!-- Events from the scheduling library -->
    <logger name="DemiCode.Scheduling">
      <level value="INFO" />
    </logger>

    <!-- Appenders -->
    
    <!-- Rolling File Appender - Creates daily log files with size limits -->
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="logs\schedulerservice.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>

    <!-- Event Log Appender - Writes to Windows Event Log -->
    <appender name="EventLogAppender" type="log4net.Appender.EventLogAppender">
      <applicationName value="DemiCode Scheduler Service" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
      <!-- Only log warnings and above to Event Log to avoid clutter -->
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="WARN" />
        <levelMax value="FATAL" />
      </filter>
    </appender>

    <!-- Console Appender - For debugging when running in console mode -->
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
  </log4net>
</configuration>