<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DemiCode.Scheduling.Test</AssemblyName>
    <RootNamespace>DemiCode.Scheduling.Test</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{278064F4-4B71-443B-A658-626B243881EE}</ProjectGuid>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\DemiCode.Shared\DemiCode.Shared.csproj" />
    <ProjectReference Include="..\DemiCode.Scheduling\DemiCode.Scheduling.csproj" />
    <ProjectReference Include="..\DemiCode.Logging.log4net\DemiCode.Logging.log4net.csproj" />
    <ProjectReference Include="..\DemiCode.Scheduling.Test.Dummy\DemiCode.Scheduling.Test.Dummy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>

  <ItemGroup>
    <None Update="**\*.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy config file for testhost to fix runtime configuration issues -->
  <Target Name="CopyConfigForTestHost" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll.config" 
          DestinationFiles="$(OutDir)testhost.dll.config" 
          SkipUnchangedFiles="true" 
          Condition="Exists('$(OutDir)$(AssemblyName).dll.config')" />
  </Target>
</Project>
