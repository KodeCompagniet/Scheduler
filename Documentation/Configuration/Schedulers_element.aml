<?xml version="1.0" encoding="utf-8"?>
<topic id="c00e0fbf-4063-47bc-8423-b8dc4e52fd27" revisionNumber="1">
  <developerConceptualDocument
    xmlns="http://ddue.schemas.microsoft.com/authoring/2003/5"
    xmlns:xlink="http://www.w3.org/1999/xlink">

    <introduction>
      <para>Collection of <legacyBold>scheduler</legacyBold> elements. The collection must contain at least one element and at least one element 
                with a name matching the <legacyBold>defaultScheduler</legacyBold> attribute on <link xlink:href="0ad38964-0c44-4e15-86aa-0a121c1741af">the scheduling element</link>.</para>
    </introduction>

           
  
<section>
  <content>
    <code language="xml">
            &lt;schedulers&gt;
                &lt;scheduler name=&quot;somename&quot; /&gt;
                &lt;scheduler /&gt;
                <!-- ... -->
            &lt;/schedulers&gt;
            </code>
	</content>
</section>

            
<section>
  <title>Attributes and Elements</title>
  <content>

	<table>
		<title>Attributes</title>
			<para>None.</para>
	</table>


	<table>
		<title>Child Elements</title>
       
       <tableHeader>
			<row>
				<entry>Element</entry>
				<entry>Description</entry>
			</row>
		</tableHeader>
		
			<row>
				<entry>
					<legacyBold><link xlink:href="6204c862-a7b7-45a5-b870-08b3771a7308">scheduler</link> </legacyBold>
				</entry>
				<entry>
					A scheduler configuration element used to configure one instance of a <codeEntityReference qualifyHint="false">T:DemiCode.Scheduling.Scheduler</codeEntityReference>.
				</entry>
			</row>
	</table>
                
	<table>                
		<title>Parent Elements</title>
		
		<tableHeader>
			<row>
				<entry>Element</entry>
				<entry>Description</entry>
			</row>
		</tableHeader>		
		
			<row>
				<entry><link xlink:href="0ad38964-0c44-4e15-86aa-0a121c1741af">scheduling</link></entry>
				<entry>Collection of one or more <legacyBold>schedule</legacyBold> elements.</entry>
			</row>
	</table>
  </content>
</section>
                
            


    <relatedTopics>
    </relatedTopics>

  </developerConceptualDocument>
</topic>
