<?xml version="1.0" encoding="utf-8"?>
<topic id="c2317c88-a041-4ee6-86d1-067f8030d878" revisionNumber="1">
  <developerConceptualDocument
    xmlns="http://ddue.schemas.microsoft.com/authoring/2003/5"
    xmlns:xlink="http://www.w3.org/1999/xlink">

    <introduction>
		<para>The <legacyBold>ConsoleLogger</legacyBold> element configures DemiCode Scheduler to output logging information to the console.
               This logger is usefull in console applications and debugging scenarios.</para>
    </introduction>

    
  
<section>
	<content>
		<code language="xml">
            &lt;loggers&gt;
                &lt;ConsoleLogger /&gt;
            &lt;/loggers&gt; 
		</code>
	</content>
</section>
                                
    

<section>
  <title>Attributes and Elements</title>
  <content>
    <table>
	<title>Attributes</title>
		<para>
			None.
		</para>
	</table>     
            
	<table>
		<title>Child Elements</title>
			<para>
				None.
			</para>
	</table>           
            
	<table>
		<title>Parent Elements</title>
                
			<tableHeader>
				<row>
					<entry>Element</entry>
					<entry>Description</entry>
				</row>
			</tableHeader>
			
			<row>
				<entry><legacyBold>
					<link xlink:href="a82cc791-a9fe-45a3-8135-4bb30f8af656">loggers</link></legacyBold>
				</entry>
				<entry>
					Collection of one or more <legacyBold>logger</legacyBold> elements.
				</entry>
			</row>
	</table>
  </content>
</section>
    

   

