<?xml version="1.0" encoding="utf-8"?>
<topic id="7ea930d8-a47c-401a-929d-f95040cca53d" revisionNumber="1">
  <developerConceptualDocument
    xmlns="http://ddue.schemas.microsoft.com/authoring/2003/5"
    xmlns:xlink="http://www.w3.org/1999/xlink">

    <introduction>
		<para>The <legacyBold>Log4netLogger</legacyBold> element configures DemiCode Scheduler to use the <externalLink>
		<linkText>log4net</linkText>
		<linkUri>http://logging.apache.org/log4net/</linkUri>
		</externalLink> framework.</para>
    </introduction>

 
<section>
  <content>
    <code language="xml">
            &lt;loggers&gt;
                &lt;Log4netLogger /&gt;
            &lt;/loggers&gt; 
	</code>
  </content>
</section>
  

<section>
  <title>Attributes and Elements</title>
  <content>
    
	<table>
		<title>Attributes</title>
			<para>
				None.
			</para>
	</table>     
            
	<table>
		<title>Child Elements</title>
			<para>
				None.
			</para>
	</table>           
            
	<table>
		<title>Parent Elements</title>
                
			<tableHeader>
				<row>
					<entry>Element</entry>
					<entry>Description</entry>
				</row>
			</tableHeader>
			
				<row>
					<entry><legacyBold>
						<link xlink:href="a82cc791-a9fe-45a3-8135-4bb30f8af656">loggers</link></legacyBold>
					</entry>
					<entry>
						Collection of one or more <legacyBold>logger</legacyBold> elements.
					</entry>
				</row>
	</table>
  </content>
</section>
    

                
         
    

