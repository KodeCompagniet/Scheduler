<?xml version="1.0" encoding="utf-8"?>
<topic id="80913175-28b9-46b1-ae4c-455d8fc75d46" revisionNumber="1">
  <developerConceptualDocument
    xmlns="http://ddue.schemas.microsoft.com/authoring/2003/5"
    xmlns:xlink="http://www.w3.org/1999/xlink">

    <introduction>
      <para>The
                <codeEntityReference qualifyHint="false">T:DemiCode.Scheduling.Tasks.ApplicationTask</codeEntityReference>
                executes a specified application or batch file. This is usefull in scenarios where you have existing applications that performs
               some job and you need to configure your scheduler to execute this jobs on schedule.</para>
    </introduction>

   
                                    


<section>
	<content>
    	<code language="xml">
            &lt;ApplicationTask path=&quot;..\..\somebatch.cmd&quot; /&gt;
		</code>
	</content>
</section>

    
        

<section>
  <title>Attributes and Elements</title>
  <content>
  
	<table>
    	<title>Attributes</title>
    
		<tableHeader>
			<row>
				<entry>Attribute</entry>
				<entry>Description</entry>
			</row>
		</tableHeader>
		
			<row>
				<entry>
					<legacyBold>path</legacyBold>
				</entry>
				<entry>
					Path and filename of an executable the task will run.
				</entry>
			</row>
			<row>
				<entry>
					<legacyBold>parameter</legacyBold>
				</entry>
				<entry>
					Optional attribute(s).<para/>
					The parameter attribute can have any valid attribute name other than &quot;path&quot;
					and represents parameters passed to the executable as command-line parameters. One or more attributes
					can be declared as long as the names are unique.
				</entry>
			</row>
	</table>
	
	<table>
    	<title>Child Elements</title>
    
		<tableHeader>
			<row>
				<entry>Element</entry>
				<entry>Description</entry>
			</row>
		</tableHeader>
                
			<row>
				<entry>
					<legacyBold><link xlink:href="100acdd4-daa3-4e8d-b09d-ad27d242a4af">scheduleref</link></legacyBold>
				</entry>
				<entry>
					Reference to a schedule that this task should be associated with.
				</entry>
			</row>
	</table>
	
	<table>
    	<title>Parent Elements</title>
    
		<tableHeader>
			<row>
				<entry>Element</entry>
				<entry>Description</entry>
			</row>
		</tableHeader>

			<row>
				<entry>
					<legacyBold><link xlink:href="6204c862-a7b7-45a5-b870-08b3771a7308">tasks</link></legacyBold>
				</entry>
				<entry>
					Collection of one or more <legacyBold>task</legacyBold> elements.
				</entry>
			</row>
	</table>
  </content>
</section>
            
        
    

    <relatedTopics>
    </relatedTopics>

  </developerConceptualDocument>
</topic>
