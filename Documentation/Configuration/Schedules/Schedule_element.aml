<?xml version="1.0" encoding="utf-8"?>
<topic id="c7ca10b4-86cf-4f36-a961-826165893353" revisionNumber="1">
  <developerConceptualDocument
    xmlns="http://ddue.schemas.microsoft.com/authoring/2003/5"
    xmlns:xlink="http://www.w3.org/1999/xlink">

    <introduction>
      <para>The <legacyBold>schedule</legacyBold> element stores configuration for one schedule instance.</para>
    </introduction>

    

<section>
  <content>
    <code language="xml">
            &lt;schedule name=&quot;oneshot&quot; type=&quot;Schedules.MyOneShotSchedule, Schedules&quot;&gt;
                &lt;!-- schedule-spesific configuration --&gt;
            &lt;/schedule&gt;
	</code>
  </content>
</section>
                                    
    

<section>
  <title>Attributes and Elements</title>
  <content>
	
	<table>
 		<title>Attributes</title>
 		<tableHeader>
			<row>
				<entry>Attribute</entry>
				<entry> Description</entry>
			</row>
		</tableHeader>
			<row>
				<entry>
					<legacyBold>name</legacyBold>
				</entry>
				<entry>
					Optional attribute<para/>
					Name of the schedule configuration element. This value can later be used as parameter
					in <codeEntityReference qualifyHint="false">P:DemiCode.Scheduling.Scheduler.Item(System.String)</codeEntityReference>.
				</entry>
			</row>
			<row>
				<entry>
					<legacyBold>type</legacyBold>
				</entry>
				<entry>
					Fully qualified type name of the class that implements this schedule.
				</entry>
			</row>
	</table>
                
	<table>                
		<title>Child Elements</title>
			<para>
                The actual configuration elements depends on the schedule type. If you are using a third-party schedule, 
                consult the third-party documentation. If you are using a built-in scheduler, refer to the corresponding <link xlink:href="6204c862-a7b7-45a5-b870-08b3771a7308">help section</link>.
			</para>
	</table>
                
	<table>                
		<title>Parent Elements</title>
        <tableHeader>
			<row>
				<entry>Element</entry>
				<entry>Description</entry>
			</row>
		</tableHeader> 	
			
			<row>
				<entry><legacyBold>
					<link xlink:href="6204c862-a7b7-45a5-b870-08b3771a7308">scheduler</link></legacyBold>
				</entry>
				<entry>
					Collection of one or more <legacyBold>schedule</legacyBold> elements.
				</entry>
			</row>
	</table>
  </content>
</section>
       
            
   

    <relatedTopics>
    </relatedTopics>

  </developerConceptualDocument>
</topic>
