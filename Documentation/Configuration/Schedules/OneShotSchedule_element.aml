<?xml version="1.0" encoding="utf-8"?>
<topic id="2d9af591-a413-41ca-9c27-4de9f6eae086" revisionNumber="1">
  <developerConceptualDocument
    xmlns="http://ddue.schemas.microsoft.com/authoring/2003/5"
    xmlns:xlink="http://www.w3.org/1999/xlink">

    <introduction>
   		<para>
      		The <codeEntityReference qualifyHint="false">T:DemiCode.Scheduling.Schedules.OneShotSchedule</codeEntityReference> fires one time on a specific date.
   		</para>
    </introduction>

    
   
<section>
  <content>
    <code language="xml">
            &lt;OneShotSchedule name=&quot;MyOneShot&quot;&gt;
                &lt;time&gt;2007-07-01 15:20:00&lt;/time&gt;
            &lt;/OneShotSchedule&gt;
	</code>
  </content>
</section>
 
        
            
 
<section>
  <title>Attributes and Elements</title>
  <content>
	<table>
		<title>Attributes</title>
        <tableHeader>
			<row>
				<entry>Attribute</entry>
				<entry>Description</entry>
			</row>
		</tableHeader>	
			
			<row>
				<entry>
					<legacyBold>name</legacyBold>
				</entry>
				<entry>
					Optional attribute<para/>
					Name of the scheduler configuration element. This value can later be used to reference the desired configuration when
					creating instances of the <codeEntityReference qualifyHint="false">T:DemiCode.Scheduling.Scheduler</codeEntityReference>.
				</entry>
			</row>
	</table>
    
    <table>
		<title>Child Elements</title>
		<tableHeader>
			<row>
				<entry>Element</entry>
				<entry>Description</entry>
			</row>
		</tableHeader>
			<row>
				<entry><legacyBold>time</legacyBold></entry>
				<entry>
					The date and time when the schedule will fire.
				</entry>
			</row>
	</table>
	
	<table>
		<title>Parent Elements</title>
		<tableHeader>
			<row>
 				<entry>Element</entry>
				<entry>Description</entry>
			</row>
		</tableHeader>
			<row>
				<entry><legacyBold>
					<link xlink:href="6204c862-a7b7-45a5-b870-08b3771a7308">scheduler</link></legacyBold>
				</entry>
				<entry>
					Collection of one or more <legacyBold>schedule</legacyBold> elements.
				</entry>
			</row>
	</table>
  </content>
</section>
           
                 
    

