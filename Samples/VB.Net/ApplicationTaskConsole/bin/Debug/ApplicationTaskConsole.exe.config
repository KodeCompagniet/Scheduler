<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="scheduling" type="DemiCode.Scheduling.Configuration.SchedulerSettings, DemiCode.Scheduling, Culture=neutral, PublicKeyToken=069d10bcdee4c3e4"/>
	</configSections>

	<scheduling defaultScheduler="prod">
		<schedulers>
			<scheduler name="prod">
				<tasks>
					<task type="ApplicationTaskConsole.Tasks.ApplicationTask, ApplicationTaskConsole"
						  path="cmd" arguments="/K &quot;echo Application executed" />
				</tasks>
				<loggers>
					<ConsoleLogger />
				</loggers>
				<IntervalSchedule name="interval">
					<start>2006-11-30 15:50:00</start>
					<interval>00:00:10</interval>
				</IntervalSchedule>
			</scheduler>
		</schedulers>
	</scheduling>

</configuration>