<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="scheduling" type="DemiCode.Scheduling.Configuration.SchedulerSettings, DemiCode.Scheduling, Culture=neutral, PublicKeyToken=069d10bcdee4c3e4"/>
	</configSections>

	<scheduling defaultScheduler="prod">
		<schedulers>
			<scheduler name="prod">
				<schedule
					name="Weekly"
				  type="DemiCode.Scheduling.Schedules.WeeklySchedule, DemiCode.Scheduling, Culture=neutral, PublicKeyToken=069d10bcdee4c3e4" >
					<fromDate>2005-01-01</fromDate>
					<toDate>2009-12-31</toDate>
					<timeOfDay>13:32:00</timeOfDay>
					<days>
						<day>monday</day>
						<day>tuesday</day>
						<day>thursday</day>
					</days>
				</schedule>
				<IntervalSchedule name="Interval">
					<start>2006-11-30 15:50:00</start>
					<interval>00:00:05</interval>
				</IntervalSchedule>
			</scheduler>
		</schedulers>
	</scheduling>

</configuration>