<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.web>
		<compilation debug="true" />
	</system.web>
	<system.serviceModel>
		<services>
			<service name="DemiCode.Logging.Feeds.StatusFeedService" behaviorConfiguration="statusFeedServiceBehaviour">
				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:8731/DemiCode/" />
					</baseAddresses>
				</host>
				<endpoint contract="DemiCode.Logging.Feeds.IStatusFeed" address="StatusFeed" binding="webHttpBinding" behaviorConfiguration="DemiCode.Logging.Feeds.StatusFeedBehavior"/>
			</service>
		</services>
		<behaviors>
			<serviceBehaviors>
				<behavior name="statusFeedServiceBehaviour">
				</behavior>
			</serviceBehaviors>
			<endpointBehaviors>
				<behavior name="DemiCode.Logging.Feeds.StatusFeedBehavior">
					<webHttp />
				</behavior>
			</endpointBehaviors>
		</behaviors>
	</system.serviceModel>
</configuration>
