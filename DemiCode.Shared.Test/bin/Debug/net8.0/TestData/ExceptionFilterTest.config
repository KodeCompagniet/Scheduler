<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>

	<log4net >

		<appender name="InclusiveFilterTestAppender" type="log4net.Appender.MemoryAppender, log4net" >
			<filter type="DemiCode.Logging.log4net.Filters.ExceptionFilter, DemiCode.Logging.log4net">
				<regexToMatch value=".*(?=ApplicationException).*" />
				<acceptOnMatch value="true" />
			</filter>
			<filter type="log4net.Filter.DenyAllFilter" />
			<fix>Partial</fix>
		</appender>

		<appender name="ExclusiveFilterTestAppender" type="log4net.Appender.MemoryAppender, log4net" >
			<filter type="DemiCode.Logging.log4net.Filters.ExceptionFilter, DemiCode.Logging.log4net">
				<regexToMatch value=".*(?=ApplicationException).*" />
				<acceptOnMatch value="false" />
			</filter>
			<fix>Partial</fix>
		</appender>

		<appender name="ExceptionMessageAppender" type="log4net.Appender.MemoryAppender, log4net" >
			<filter type="DemiCode.Logging.log4net.Filters.ExceptionFilter, DemiCode.Logging.log4net">
				<regexToMatch value=".*(?=MessageInTheException).*" />
				<acceptOnMatch value="true" />
			</filter>
			<filter type="log4net.Filter.DenyAllFilter" />
			<fix>Partial</fix>
		</appender>

		<!-- Setup the root category, add the appenders and set the default level -->

		<root>
			<level value="DEBUG" />
			<appender-ref ref="InclusiveFilterTestAppender" />
			<appender-ref ref="ExclusiveFilterTestAppender" />
			<appender-ref ref="ExceptionMessageAppender" />
		</root>

	</log4net>

</configuration>